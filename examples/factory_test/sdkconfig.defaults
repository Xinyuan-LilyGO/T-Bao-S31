CONFIG_IDF_TARGET="esp32s31"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_HEADER_FLASHSIZE_UPDATE=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=n
CONFIG_LV_BUILD_EXAMPLES=n
CONFIG_LV_BUILD_DEMOS=n
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_24=y
CONFIG_XL9555_DEFAULT_OUTPUT=0xFC5F
CONFIG_FATFS_VFS_FSTAT_BLKSIZE=4096
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_ESP_CAM_IO_PARL_PAYLOAD_SIZE=16384
CONFIG_ESP_CAM_IO_PARL_SCCB_I2C_PORT1=y
CONFIG_ESP_CAM_IO_PARL_SCCB_I2C_PORT0=n
CONFIG_ESP_CAM_IO_PARL_OV2640=y
CONFIG_ESP_CAM_IO_PARL_OV3660=y
CONFIG_ESP_CAM_IO_PARL_OV5640=n
CONFIG_ESP_CAM_IO_PARL_NT99141=n
CONFIG_ESP_CAM_IO_PARL_FRAME_SIZE_AUTO=y
CONFIG_ESP_CAM_IO_PARL_FRAME_SIZE_MUL=1
CONFIG_ESP_CAM_IO_PARL_FRAME_SIZE_DIV=2
CONFIG_ESP_CAM_IO_PARL_FRAME_SIZE_PADDING=8192
