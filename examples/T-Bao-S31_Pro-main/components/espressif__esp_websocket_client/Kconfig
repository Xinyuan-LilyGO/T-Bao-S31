menu "ESP WebSocket client"

    config ESP_WS_CLIENT_ENABLE_DYNAMIC_BUFFER
        bool "Enable websocket client dynamic buffer for send and receive data"
        default n
        help
            Reallocate the websocket buffers for each send/receive operation.
            This reduces the idle buffer footprint when traffic is infrequent.

    config ESP_WS_CLIENT_SEPARATE_TX_LOCK
        bool "Enable separate tx lock for send and receive data"
        default n
        help
            Use a separate lock for transmit operations so senders do not
            contend with the receive path while a frame is being dispatched.

    config ESP_WS_CLIENT_TX_LOCK_TIMEOUT_MS
        int "TX lock timeout in milliseconds"
        depends on ESP_WS_CLIENT_SEPARATE_TX_LOCK
        default 2000
        help
            Maximum time to wait for the websocket transmit lock.

endmenu
