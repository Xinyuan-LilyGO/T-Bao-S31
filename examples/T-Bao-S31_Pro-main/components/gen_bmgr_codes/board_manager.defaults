# --- Board-specific configuration (managed by esp_board_manager) ---
# Board: tbao_s31_board
CONFIG_IDF_TARGET="esp32s31"
CONFIG_ESP_BOARD_TBAO_S31_BOARD=y
CONFIG_ESP_BOARD_NAME="tbao_s31_board"

CONFIG_ESP_BOARD_PERIPH_I2C_SUPPORT=y
CONFIG_ESP_BOARD_PERIPH_I2S_SUPPORT=y
CONFIG_ESP_BOARD_PERIPH_LEDC_SUPPORT=y
CONFIG_ESP_BOARD_DEV_AUDIO_CODEC_SUPPORT=y
CONFIG_ESP_BOARD_DEV_DISPLAY_LCD_SUPPORT=y
CONFIG_ESP_BOARD_DEV_FS_FAT_SUPPORT=y
CONFIG_ESP_BOARD_DEV_GPIO_EXPANDER_SUPPORT=y
CONFIG_ESP_BOARD_DEV_LCD_TOUCH_SUPPORT=y
CONFIG_ESP_BOARD_DEV_LEDC_CTRL_SUPPORT=y
CONFIG_ESP_BOARD_DEV_DISPLAY_LCD_SUB_PARLIO_SUPPORT=y
CONFIG_ESP_BOARD_DEV_FS_FAT_SUB_SDMMC_SUPPORT=y
CONFIG_ESP_BOARD_DEV_LCD_TOUCH_SUB_I2C_SUPPORT=y
CONFIG_ESP_BOARD_DEV_LCD_TOUCH_I2C_SUPPORT=y

# Camera support is provided by the local PARLIO component.
CONFIG_ESP_CAM_IO_PARL_OV2640=y
CONFIG_ESP_CAM_IO_PARL_OV3660=y
CONFIG_ESP_CAM_IO_PARL_SCCB_I2C_PORT1=y
CONFIG_ESP_CAM_IO_PARL_FRAME_SIZE_AUTO=y
CONFIG_ESP_CAM_IO_PARL_FRAME_SIZE_MUL=1
CONFIG_ESP_CAM_IO_PARL_FRAME_SIZE_DIV=2
CONFIG_ESP_CAM_IO_PARL_FRAME_SIZE_PADDING=8192
CONFIG_ESP_CAM_IO_PARL_PAYLOAD_SIZE=16384
CONFIG_SPIRAM=y
# --- End of board-specific configuration ---
