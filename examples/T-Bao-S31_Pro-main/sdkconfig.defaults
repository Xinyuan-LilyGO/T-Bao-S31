CONFIG_IDF_TARGET="esp32s31"
CONFIG_COMPILER_CXX_EXCEPTIONS=y
CONFIG_COMPILER_CXX_EXCEPTIONS_EMG_POOL_SIZE=1024

CONFIG_BOOTLOADER_COMPILER_OPTIMIZATION_PERF=y
CONFIG_BOOTLOADER_LOG_LEVEL_NONE=y
CONFIG_BOOTLOADER_SKIP_VALIDATE_ALWAYS=y
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

CONFIG_HTTPD_MAX_REQ_HDR_LEN=2048
CONFIG_HTTPD_MAX_URI_LEN=2048

CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x8000
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
# PSRAM (external SPI RAM, required by RGB LCD frame buffer)
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_USE_MALLOC=y
# Keep ordinary allocations larger than 4 KiB out of internal SRAM. With the
# IDF default (16 KiB) malloc() kept filling the ~280 KiB internal heap until
# only a few hundred bytes were left; the first wake then could not allocate
# the 8 KiB WebSocket receive-task stack (ESP_ERR_NO_MEM) and the session died
# before hello/audio were sent. Internal SRAM is needed by Wi-Fi DMA, task
# stacks, WakeNet and LCD/PARLIO DMA.
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
# Keep a pool for MALLOC_CAP_INTERNAL requests (task stacks, DMA). A normal
# malloc() can only fall back to it after the ordinary internal heap is gone.
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=65536
# Wi-Fi and lwIP buffers prefer PSRAM first; the internal DRAM stays available
# for WakeNet, DMA descriptors and the WebSocket/TLS task stacks.
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
# Put the .bss of lwip / net80211 / pp / bt and any variable marked
# EXT_RAM_BSS_ATTR into PSRAM. This is static data that merely sits in internal
# SRAM for the whole uptime; moving it directly raises the internal heap (the
# linker reuses the freed DIRAM for the heap). The big app-owned arrays
# (video/music scan results, the timer duration label buffer, the music URL) are
# marked EXT_RAM_BSS_ATTR for the same reason.
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
# WebSocket transport task stack can live in PSRAM; the task control block
# remains allocated from internal SRAM by FreeRTOS.
CONFIG_FREERTOS_TASK_CREATE_ALLOW_EXT_MEM=y

# Offline face-following detector. Keep both model files in app Flash rodata so
# the existing model SPIFFS partition and its label remain unchanged.
CONFIG_FLASH_HUMAN_FACE_DETECT_MSRMNP_S8_V1=y
CONFIG_HUMAN_FACE_DETECT_MSRMNP_S8_V1=y
CONFIG_HUMAN_FACE_DETECT_MODEL_IN_FLASH_RODATA=y

# S31 qacc (WakeNet/DSP) cannot access LP/RTC fast RAM (0x2E); keeping it out of
# the MALLOC_CAP_INTERNAL heap forces SR activation buffers into internal SRAM
# (0x2F) where the qacc bus can reach them. Without this, wakenet crashes with a
# Load access fault reading 0x2e00xxxx during model_run.
CONFIG_ESP_SYSTEM_ALLOW_RTC_FAST_MEM_AS_HEAP=n

# Watchdog timeout 30s: at boot (wifi connect + camera + audio + emote all
# starting on CPU0) the IDLE0 task can be starved >10s, tripping the old 10s
# timeout and rebooting right after WiFi connects. 30s covers the startup burst.
CONFIG_ESP_TASK_WDT_TIMEOUT_S=30
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
CONFIG_FREERTOS_USE_STATS_FORMATTING_FUNCTIONS=y

CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
# Keep TLS handshake/record buffers in PSRAM so WakeNet, audio, and realtime
# tasks retain enough internal SRAM for wakeup and WebSocket writes.
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
# CONFIG_MBEDTLS_INTERNAL_MEM_ALLOC is not set
# TLS buffers live in PSRAM on this board. ESP32-S31 AES DMA then needs
# internal MALLOC_CAP_DMA bounce buffers, which competes with audio/display
# workloads and can abort TLS record decryption when the internal heap is low.
# Keep TLS on the software AES path to avoid that hidden DMA allocation.
# CONFIG_MBEDTLS_HARDWARE_AES is not set
# CONFIG_MBEDTLS_HARDWARE_GCM is not set
# The ESP hardware-SHA PSA driver allocates its hash context with
# MALLOC_CAP_DMA|MALLOC_CAP_INTERNAL on every psa_hash_setup(). Once a few
# conversations had consumed the internal heap, mbedtls_ssl_setup() failed
# with PSA_ERROR_INSUFFICIENT_MEMORY (-0x8D) and the device could no longer
# reconnect/wake until reboot. Software SHA keeps the context inside the PSA
# operation object (PSRAM) and needs no hidden internal DMA allocation.
# CONFIG_MBEDTLS_HARDWARE_SHA is not set
# CONFIG_MBEDTLS_AES_USE_INTERRUPT is not set
# CONFIG_MBEDTLS_AES_HW_SMALL_DATA_LEN_OPTIM is not set
CONFIG_MBEDTLS_SSL_KEEP_PEER_CERTIFICATE=n
# Keep incoming MCP/audio processing from contending with the microphone TX
# path on the WebSocket client's receive lock.
CONFIG_ESP_WS_CLIENT_SEPARATE_TX_LOCK=y
CONFIG_ESP_WS_CLIENT_TX_LOCK_TIMEOUT_MS=2000
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
CONFIG_ESP_WIFI_DYNAMIC_RX_MGMT_BUFFER=y

# PHY PLL tracking allocates an esp_timer with ESP_ERROR_CHECK on EVERY
# esp_phy_enable(), and the Wi-Fi "dream" power-save path enables/disables the
# PHY continuously. When internal SRAM is fragmented (normal on this board once
# XiaoZhi's AFE/WebSocket are up), that ~100-byte allocation fails and IDF
# aborts the whole device (phy_track_pll_init, ESP_ERR_NO_MEM) even though the
# failure is unrelated to the user's action. Disabling the periodic tracking
# removes the only heap allocation in that path; the PHY keeps its boot-time
# calibration. This trades a small temperature-drift margin for a device that
# cannot be taken down by transient heap fragmentation.
CONFIG_ESP_PHY_DEBUG=y
CONFIG_ESP_PHY_DISABLE_PLL_TRACK=y

# These entries are copied from ESP-HI (ESP32C3) to reduce memory usage
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=6
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=8
# Each static TX buffer costs ~1.6 KiB of internal SRAM and is allocated for the
# whole lifetime of the Wi-Fi driver. The default of 16 buffers reserves ~25 KiB
# of the small internal heap even while idle. Data frames are also carried by
# the 32 PSRAM-backed CONFIG_ESP_WIFI_CACHE_TX_BUFFER_NUM buffers, so 8 static
# buffers are enough for audio/WebSocket traffic and MJPEG bursts while freeing
# ~13 KiB for LVGL/WakeNet/timers on this memory-constrained board.
CONFIG_ESP_WIFI_STATIC_TX_BUFFER_NUM=8
CONFIG_NEWLIB_NANO_FORMAT=y
CONFIG_ESP_WIFI_ENTERPRISE_SUPPORT=n

CONFIG_CODEC_I2C_BACKWARD_COMPATIBLE=n

# Fix ML307 FIFO Overflow
CONFIG_UART_ISR_IN_IRAM=y

# LVGL 9.2.2
# Enable LVGL adapter FS so EAF assets can be mounted (esp_lv_adapter_fs_mount)
CONFIG_ESP_LVGL_ADAPTER_ENABLE_FS=y
CONFIG_MMAP_FILE_NAME_LENGTH=32
CONFIG_LV_DEF_REFR_PERIOD=10
CONFIG_LV_USE_GIF=y

# Use the ESP32-S31 PPA SRM hardware for LVGL software rotation.
# CONFIG_LVGL_PORT_ENABLE_PPA=y

# Keep the motion and servo tools in the first MCP response while limiting the
# internal MCP response allocation on the memory-constrained S31.
CONFIG_MCP_TOOLLIST_MAX_SIZE=8192

CONFIG_LV_OS_NONE=y
CONFIG_LV_USE_OS=0
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_USE_CLIB_SPRINTF=y
CONFIG_LV_USE_IMGFONT=y

# Use compressed font
CONFIG_LV_FONT_FMT_TXT_LARGE=y
CONFIG_LV_USE_FONT_COMPRESSED=y
CONFIG_LV_USE_FONT_PLACEHOLDER=y

# Enable Chinese font support (Source Han Sans SC CJK)
CONFIG_LV_FONT_SOURCE_HAN_SANS_SC_14_CJK=y
CONFIG_LV_FONT_DEFAULT_SOURCE_HAN_SANS_SC_14_CJK=y
CONFIG_LV_FONT_MONTSERRAT_30=y

# Disable extra widgets to save flash size
CONFIG_LV_USE_ANIMIMG=n
CONFIG_LV_USE_CALENDAR=n
CONFIG_LV_USE_CALENDAR_HEADER_ARROW=n
CONFIG_LV_USE_CALENDAR_HEADER_DROPDOWN=n
CONFIG_LV_USE_CHART=n
CONFIG_LV_USE_KEYBOARD=n
CONFIG_LV_USE_LED=n
CONFIG_LV_USE_LIST=n
CONFIG_LV_USE_MENU=n
CONFIG_LV_USE_MSGBOX=n
CONFIG_LV_USE_SPAN=n
CONFIG_LV_USE_SPINBOX=n
CONFIG_LV_USE_SPINNER=n
CONFIG_LV_USE_TABVIEW=n
CONFIG_LV_USE_TILEVIEW=n
CONFIG_LV_USE_WIN=n

CONFIG_LV_BUILD_EXAMPLES=n

# Rendering performance: circle cache for the round 360x360 screen.
# NOTE: LVGL's PPA draw unit (LV_USE_PPA) was evaluated but the component
# manager cannot resolve lvgl's PPA dependency on this managed-component setup
# ("component_requirements.py cannot match lvgl__lvgl") — reverting to the
# stable software render baseline. RISC-V V blend is C emulation (no gain).
CONFIG_LV_DRAW_SW_CIRCLE_CACHE_SIZE=8

# lwIP: SACK improves throughput on lossy Wi-Fi; larger send/recv windows help
# the MJPEG preview stream and websocket audio move larger bursts per ACK.
CONFIG_LWIP_TCP_SACK_OUT=y
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=8192
CONFIG_LWIP_TCP_WND_DEFAULT=8192
CONFIG_TCP_SND_BUF_DEFAULT=8192

# Official emote engine: make the toast caption under the face wide enough to
# show a full sentence scrolling, positioned below the eyes.
CONFIG_EMOTE_DEF_SCROLL_SPEED=40
CONFIG_EMOTE_DEF_LABEL_WIDTH=340
CONFIG_EMOTE_DEF_LABEL_Y_OFFSET=268
CONFIG_EMOTE_DEF_BG_COLOR=0x000000

CONFIG_VOICE_WAKEUP_MODE=y
CONFIG_AUDIO_AFE_ENABLE=y
CONFIG_SR_WN_WN9_NIHAOMIAOBAN_TTS2=y
CONFIG_SR_WN_WN9_NIHAOXIAOZHI_TTS=y

# Xiaozhi Chat Application: use WebSocket transport (same domain as OTA,
# so the default cert bundle validates it; MQTT endpoint uses a different CA
# not in the bundle and fails the TLS handshake).
CONFIG_XIAOZHI_CHAT_APP_TRANSPORT_WEBSOCKET=y

# Keep the long-lived audio input task stack out of scarce internal SRAM.
# The dynamic path is required for PSRAM-backed task stacks.
# CONFIG_XIAOZHI_AUDIO_TASK_ALLOC_STATIC is not set
CONFIG_XIAOZHI_AUDIO_TASK_ALLOC_DYNAMIC=y
CONFIG_XIAOZHI_STACK_IN_PSRAM=y

# Camera: T-Bao S31 PARLIO JPEG capture with OV2640/OV3660 compatibility.
CONFIG_ESP_BOARD_DEV_CAMERA_SUPPORT=n
CONFIG_TBAO_CAMERA_SUPPORT=y
CONFIG_TBAO_CAMERA_OV3660=n
CONFIG_TBAO_CAMERA_OV2640_CORE_1V3=n
CONFIG_ESP_CAM_IO_PARL_OV2640=y
CONFIG_ESP_CAM_IO_PARL_OV3660=y
CONFIG_ESP_CAM_IO_PARL_OV5640=n
CONFIG_ESP_CAM_IO_PARL_NT99141=n
CONFIG_ESP_CAM_IO_PARL_FRAME_SIZE_AUTO=y
CONFIG_ESP_CAM_IO_PARL_FRAME_SIZE_MUL=1
CONFIG_ESP_CAM_IO_PARL_FRAME_SIZE_DIV=2
CONFIG_ESP_CAM_IO_PARL_FRAME_SIZE_PADDING=8192
CONFIG_ESP_CAM_IO_PARL_SCCB_I2C_PORT1=y
CONFIG_ESP_CAM_IO_PARL_SCCB_I2C_PORT0=n
CONFIG_ESP_CAM_IO_PARL_PAYLOAD_SIZE=16384

# Wi-Fi (protocol_examples_common)
CONFIG_EXAMPLE_WIFI_SSID="HONOR"
CONFIG_EXAMPLE_WIFI_PASSWORD="JIN060519"

# Bluetooth A2DP sink (classic BR/EDR only; no esp_bt_controller_mem_release,
# which previously crashed the S31 controller). BLE kept off to save RAM; the
# app does not use BLE. S31 controller support requires ESP-IDF >= 08e0d30a.
CONFIG_BT_ENABLED=y
CONFIG_BTDM_CTRL_MODE_BR_EDR_ONLY=y
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_CLASSIC_ENABLED=y
CONFIG_BT_A2DP_ENABLE=y
CONFIG_BT_BLE_ENABLED=n
